<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Meridian.Tests</AssemblyName>
    <RootNamespace>Meridian.Tests</RootNamespace>
    <Description>Unit tests for Meridian's pure-logic components (scoring, fusion, retry/fallback, context assembly) that don't require live model credentials.</Description>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="1.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Meridian.Context\Meridian.Context.csproj" />
    <ProjectReference Include="..\..\src\Meridian.Models\Meridian.Models.csproj" />
    <ProjectReference Include="..\..\src\Meridian.Knowledge\Meridian.Knowledge.csproj" />
  </ItemGroup>

</Project>
